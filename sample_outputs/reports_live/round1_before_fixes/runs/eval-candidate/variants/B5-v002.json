    "concept": {
      "variant_id": "B5-v002",
      "brief_id": "B5",
      "direction": "monolith_slab",
      "name": "Monolith Slab Detector",
      "form_language": "A single chamfered slab of recycled ABS, read as one billet of material rather than an assembly. Broad chamfered top and bottom edges (3.5 mm) replace radiuses so the part reads as a machined monolith while staying draft-safe for injection moulding. The front face is a flat plane carrying a horizontal dark display band, a fine louvered intake grille across the top edge, and a single recessed USB-C notch on the bottom edge. No parting-line ornament, no badges, no visible fasteners; the seam is a straight shadow gap at 60 percent of the thickness.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 26.0
      },
      "corner_radius_mm": 9.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 52.0,
        "height": 22.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "smooth_matte",
        "color": "graphite black, 2 percent gloss unit, moulded-in matte with soft-touch paint on the exterior shell only",
        "secondary_ops": [
          "paint",
          "laser_etch",
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the chamfered_slab silhouette with a 3.5 mm chamfer on the top and bottom long edges; this chamfer is the entire brand read and must not be softened into a radius in CAD or tooling.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Display window stays a 52 x 22 mm horizontal band centred at 38 percent height on the front face; do not enlarge or re-centre it, as the remaining front area carries the intake grille and USB notch balance.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Intake is a louvered grille on the top face, centred, with a moulded-in gasket land and ePTFE membrane behind it to satisfy IP67 without opening the front face.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Exterior shell is soft-touch painted rABS in matte graphite; the interior chassis stays unpainted rABS so paint does not contaminate the sensor path or the recycled material stream at end of life.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C is a recessed notch on the bottom face, centred, with a moulded silicone plug tether so the port does not break IP67 when closed.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Housing BOM must stay at or below CNY 18 per unit at 10,000 units per year; the soft-touch paint is the single largest line item and must not be expanded to the interior or to secondary parts.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This concept accepts the contract relaxations (26 mm height, 180 g mass, CNY 18 ceiling) and resolves the remaining conflicts by construction. IP67 versus slim profile is handled by moving the only open area to the top face, where a louvered grille over an ePTFE membrane and a moulded gasket land can be sealed with a single continuous gasket, keeping the front face a closed painted plane. IP67 versus mass is handled by a 1.5 mm nominal wall in rABS with local ribs only at the display and USB bosses, keeping the housing near 38 g and total product near 130 g, inside the 180 g ceiling with margin. Cost versus finish is handled by limiting soft-touch paint to the exterior shell and using laser etch for the display bezel graphic instead of a separate part. The chamfered slab is chosen over a rounded rect because the straight chamfer reads as a single machined billet at this thickness, which is the premium cue the brief asks for, and because chamfers are more forgiving of moulding sink than large radiuses on a 26 mm deep part made from recycled ABS with variable flow. The variant is named monolith_slab and is intended as the flagship direction, not the value direction."
    },
