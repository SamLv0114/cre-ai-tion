        "face": "front",
        "x_pct": 50.0,
        "y_pct": 30.0
      },
      "display_window_mm": {
        "width": 42.0,
        "height": 22.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 72.0
      },
      "usb": {
        "face": "right",
        "x_pct": 72.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "PC-ABS",
        "finish": "textured_heavy",
        "color": "Safety Orange (Pantone 152C) body, charcoal grey (Pantone 425C) bumpers and display bezel",
        "secondary_ops": [
          "pad_print",
          "laser_etch",
          "tpe_overmold"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Four TPE overmoulded corner bumpers must project 2.5 mm beyond all adjacent body faces and have a minimum wall of 3 mm to absorb 1.5 m concrete drop energy without cracking.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "The front intake grille must provide at least 15% open area yet be backed by an internal ePTFE membrane and sealed with a continuous gasket to maintain IP65.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "All user-touch surfaces (side grips, bumper flanks, button pads) must use a heavy texture with Ra > 6 \u00b5m and minimum 4 mm rib pitch to remain operable with thick work gloves.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "The main body colour must remain safety orange Pantone 152C with UV-stabilised PC-ABS and no gloss topcoat, verified to ASTM G154 500 h with \u0394E < 3.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "The USB-C port on the right face must sit inside a recessed pocket with a captive silicone flap gasket, and the pocket depth must not exceed 3 mm to allow gloved plug insertion.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "The housing must use a two-shot tool with TPE overmould on PC-ABS, no separate bumper parts, to stay within the CNY 18 BOM ceiling at 10k units/year.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This concept directly answers the rugged_bumper direction by making the bumpers structural and visual: they are overmoulded, not added, which protects corners, avoids secondary assembly cost and keeps the part count low. PC-ABS is chosen over rABS because the drop and UV requirements dominate and the cost ceiling can still be met with a two-shot tool and no separate bumper hardware. The front face layout puts the display high and the intake low, so the device can be held and read while the intake is less likely to be blocked by a gloved hand. The deep texture and ribbed sides satisfy glove use, while the recessed USB pocket with a flap keeps IP65. The safety orange body with charcoal bumpers gives high visibility and hides grime at the same time."
    },
