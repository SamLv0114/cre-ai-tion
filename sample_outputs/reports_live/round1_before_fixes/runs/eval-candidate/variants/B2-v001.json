    "concept": {
      "variant_id": "B2-v001",
      "brief_id": "B2",
      "direction": "rugged_bumper",
      "name": "SiteGuard Bumper Handheld",
      "form_language": "A squat, wide-shouldered handheld slab with four integrated rubberised corner bumpers that stand proud of the main body, giving a visual and physical crash cage. The front face is a single recessed plane containing the display window and a large textured intake grille, framed by a raised perimeter lip that sheds water. Side walls carry deep glove-friendly grip ribs, and the top edge is chamfered to guide gloved fingers. The design reads as a tool, not a gadget: high-visibility safety orange body with charcoal bumpers and a dark display bezel for contrast and dirt hiding.",
      "silhouette": "bumpered",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 6.0,
