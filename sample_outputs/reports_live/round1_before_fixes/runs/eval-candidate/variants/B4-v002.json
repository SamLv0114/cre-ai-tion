    "concept": {
      "variant_id": "B4-v002",
      "brief_id": "B4",
      "direction": "monolith_slab",
      "name": "Slab One",
      "form_language": "A calm, monolithic chamfered slab with a single uninterrupted front face; a shallow 2.5 mm chamfer traces the entire front perimeter, replacing soft radii with a precise, tool-like honesty. The display sits in a recessed pocket with a 0.8 mm shadow gap, while a narrow, recessed intake slot runs along the top face as a functional band. No visible fasteners, no paint; the rABS surface carries a fine, slightly speckled texture that reveals the material's recycled origin. The overall proportion is slim and horizontal, with a subtle 1.5 degree back-lean suggestion in the side elevation for visual stability.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 26.0
      },
      "corner_radius_mm": 2.5,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 42.0
      },
      "display_window_mm": {
        "width": 48.0,
        "height": 22.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm speckled oat",
        "secondary_ops": []
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Housing must be 100% post-consumer recycled ABS (rABS) with controlled regrind and masterbatch speckles; no paint, no coatings, no secondary finishes.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Front face must remain a single uninterrupted plane with a recessed display pocket and a 0.8 mm shadow gap; no proud bezels or applied overlays.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Intake slot must be a recessed band on the top face, 3 mm wide, running parallel to the front edge, with no separate grille component.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "USB-C port on the right face must be a clean rectangular cutout with a 0.5 mm chamfer; no rubber flap or separate door.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Housing must assemble with tool-less snap-fits designed for repeated disassembly; no screws, no adhesives, no heat stakes.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Wall thickness must remain 2.0 mm nominal with local ribs at snap-fit and boss locations to meet 1.0 m drop durability while staying under 180 g.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept translates the monolith_slab direction into a DFM-safe, sustainable housing that meets the B4 contract. The chamfered_slab silhouette with a 2.5 mm chamfer is achievable in a simple two-plate tool, avoiding the cost and sink marks of large radii. The 122 x 72 x 26 mm envelope stays within the 125 x 75 x 30 mm limit with margin for draft and snap-fit features, and the estimated housing mass is ~78 g, well under the 180 g limit after internals. The front face is deliberately reduced to a single plane with a recessed display pocket; this reduces tooling complexity and eliminates the need for a separate bezel, supporting mono-material and screw-free goals. The top intake slot is a simple milled or moulded recess that integrates with the internal sensor path without adding a grille part. The right-side USB cutout is straightforward and avoids a separate door. CMF uses only rABS with a light texture and a warm speckled oat color; the speckle is achieved via masterbatch, so no paint or coating is required. The snap-fit design follows the conflict C1 resolution: repeated disassembly without screws, validated by drop testing. This concept prioritizes carbon footprint over gloss, accepting batch-to-batch color variation as part of the honest aesthetic. All intent anchors are chosen to protect the sustainability, repairability, and cost targets through downstream engineering."
    },
