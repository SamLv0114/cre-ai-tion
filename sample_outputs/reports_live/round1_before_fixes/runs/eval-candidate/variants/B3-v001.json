    "concept": {
      "variant_id": "B3-v001",
      "brief_id": "B3",
      "direction": "soft_pebble",
      "name": "Pebble Sofa-Side Air Detector",
      "form_language": "A calm, furniture-like pebble: a gently domed rounded-rect slab with continuous soft radii, no visible parting line on the front, and a recessed lower front band that visually floats the body. The 10-degree back-lean and subtle top taper make it read as a ceramic object rather than an appliance. The front face is a single clean plane carrying only the display and a fine intake grille; the USB-C port is hidden under a flush magnetic cover on the right side, so the front remains uninterrupted.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 118.0,
        "width": 70.0,
        "height": 28.0
      },
      "corner_radius_mm": 12.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 56.0,
        "height": 24.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 72.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "smooth_matte",
        "color": "warm chalk white (RAL 9010 equivalent, 5% warm tint)",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "The front face must remain a single uninterrupted plane: no screw bosses, no parting line, no raised logos. All fasteners are internal snap-latches or hidden screws on the underside, preserving the furniture-like calm.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Display window is 56 x 24 mm minimum with a 2 mm black bezel, positioned at 38% height from the top edge. This gives 12-14 mm character height and sufficient contrast for 2-3 m sofa reading.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Intake grille is a fine horizontal slot array (0.8 mm slots, 1.2 mm pitch) recessed 0.5 mm into the lower front band, extending no higher than y=70%. It must not create a visible cutout on the side or top silhouette.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "USB-C port is on the right side face, centered at y=72% and hidden behind a flush, magnetically retained cover that is flush with the adjacent surface when closed. This keeps the front clean and the port accessible without a visible flap line on the main face.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "CMF: rABS with smooth_matte finish (SPI B-2 equivalent, 0.8-1.2 \u00b5m Ra) in warm chalk white. Soft-touch is achieved through mold texture, not additional coating, to meet cost and recyclability. Pad-print the status icons and laser-etch a subtle brand mark on the underside.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Wall thickness is 2.0 mm nominal (1.8-2.2 mm) with 1.5 mm minimum at radii, and internal ribs at 1.2 mm. This keeps the housing mass under 180 g while maintaining stiffness for a 10,000/year injection-moulded part.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This concept adapts the DFM-safe reference into a softer, furniture-like pebble for the B3 brief. The 118 x 70 x 28 mm envelope is inside the 125 x 75 x 30 mm limit and leaves room for a 92 g internal module within the 180 g mass ceiling. The 12 mm corner radius and gentle top dome remove the 'box' feel while keeping the part drawable with a simple two-plate tool and no side actions. The front face is deliberately reduced to two elements: a 56 x 24 mm display at 38% height for sofa readability, and a fine intake grille recessed into the lower band. Hidden fasteners are achieved by internal snaps and underside screws, so the front and sides show no hardware. USB-C is placed on the right side behind a flush magnetic cover, preserving the clean front. Material choice of rABS supports the sustainability priority at no cost penalty versus virgin ABS, and the smooth_matte mold texture avoids a secondary soft-touch coating, keeping the housing BOM within the CNY 18 ceiling. Pad-print and laser-etch are low-cost secondary operations that add legibility and brand without breaking the clean surface."
    },
