    "concept": {
      "variant_id": "B6-v001",
      "brief_id": "B6",
      "direction": "soft_pebble",
      "name": "Pebble Halo Desktop Detector",
      "form_language": "Soft pebble geometry: continuous convex crown and belly planes, no sharp transitions; a single flowing parting line at the widest girth keeps the wall draft simple and tooling-friendly. A gentle dusk shadow groove wraps the lower 6 mm to visually lighten the mass and hide the front intake louvre array. The face is a calm horizontal band layout - display centred and slightly raised, intake as a fine chamfered-louvre field below it, USB recessed in a bottom-front oval. Rounded, slightly domed top face gives a friendly 'crouching pet' read at desk scale.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 56.0,
        "height": 22.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 76.0
      },
      "usb": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 94.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "soft chalk white with warm grey louvre band and muted sage accent ring",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the pebble crown-to-belly curvature continuous; no flat-to-arc tangent breaks on the front or top faces, so the silhouette reads soft at 1.5 m.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Display window must stay at least 56 x 22 mm with a matte, anti-glare cover and high-contrast dark-on-light graphic; this is the readability-at-neighbouring-desk anchor at 1.5 m.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Front intake louvres must remain on the front face, spaced 2.5 mm minimum with 1.2 mm rib thickness and 15-degree downward deflection, so dust and fingerprints do not bridge the slots.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Preserve textured_light (MT-11010-equivalent) on all primary moulded surfaces; no gloss or smooth-matte substitution, because this texture hides fingerprints in shared office handling.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C port recess must remain centred on the front face above the base shadow groove with a 1.5 mm lead-in chamfer, allowing one-handed plug-in by touch.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Housing must stay within 122 x 72 x 28 mm and 180 g with a single two-part ABS-family tool; no added insert, speaker grille, or secondary shell may push unit cost above CNY 18.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA7",
          "statement": "Use rABS only if the incoming pellet price is within 3% of virgin ABS; otherwise drop to ABS without changing geometry or texture.",
          "category": "sustainability",
          "must_preserve": true
        }
      ],
      "rationale": "The pebble silhouette and 14 mm corner radius are chosen to hit the 'friendly, approachable' brief while staying inside a 2-plate injection tool: the crown-to-belly curvature is a single continuous arc family, so no undercuts or side actions are needed. The 122 x 72 x 28 mm envelope leaves 3 mm length, 3 mm width and 2 mm height margin against the contract ceiling, which is reserved for the elastomer foot pads and the display lens compression. The 56 x 22 mm display window is the largest rectangular window that can sit on the front face while keeping a 12 mm minimum rim to the pebble edge; combined with a matte anti-glare lens and 24 pt minimum numerals this meets the Q1 default of readability at 1.5 m. The intake is kept on the front, below the display, as a fine louvre field rather than a coarse grille: this is the most DFM-safe way to get > 250 mm2 of open area without thin, warp-prone ribs, and the 15-degree downward deflection keeps desk dust out. USB is moved to the bottom-front centre, recessed in an oval dimple, so it is reachable in a desk cluster and does not compete with the display read. rABS is specified as the primary material because B6 allows it and the mass target is comfortable at 2.2 mm nominal wall; the cost anchor makes the fallback to ABS explicit if rABS is not cost-competitive. Textured_light at ~MT-11010 grain depth is the specified finish because it both hides fingerprints (brief must-have) and scatters the display's edge glare, which improves glance readability. Pad-print carries the status wordmark and the small 'PM2.5 / VOC / CO2' legend; laser-etch marks the louvre band with a subtle calibration tick pattern that adds perceived precision at near-zero cost. No TPE overmold, no IML, and no paint are used, keeping the secondary-op list inside the CNY 18 BOM ceiling at 10k units/year."
    },
