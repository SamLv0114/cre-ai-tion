    "concept": {
      "variant_id": "B4-v001",
      "brief_id": "B4",
      "direction": "soft_pebble",
      "name": "Soft Pebble Mono-Shell Detector",
      "form_language": "A slim, warm pebble: two-shot-free mono-material rABS shell with a continuous softly domed front face that rolls into generous side tangents, no sharp break lines. A single shallow part-line groove at 60% height is the only visible split, doubling as a pry ledge for screw-free disassembly. The front face is a calm, honest field: a recessed unglazed display window floated on a slight plateau, a horizontal intake grille of 12 round slots grouped under the display, and a single low-profile USB-C slot at the bottom centre with a moulded lead-in chamfer. Textured, slightly speckled matte rABS throughout; all graphics are moulded-in or laser-etched, never painted.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 34.0
      },
      "display_window_mm": {
        "width": 46.0,
        "height": 22.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 68.0
      },
      "usb": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 92.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm oatmeal grey with visible dark speckle (controlled regrind masterbatch)",
        "secondary_ops": [
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Every plastic part is 100% post-consumer rABS; no paint, coating, pad-print ink, IML film, TPE overmold or adhesive. Graphics are laser-etched or moulded-in only, so the housing stays mono-material and recyclable in one stream.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Screw-free disassembly: the pebble shell splits at a single 360-degree part line into front and rear rABS parts, held by 4 moulded cantilever snap-fits with finger-pry ledges at the rear corners; snaps are designed for 20+ open/close cycles and are labelled with a moulded arrow.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Pebble silhouette with 14 mm corner radius and a 122 x 72 x 28 mm envelope leaving 3 mm length, 3 mm width and 2 mm height margin to contract limits; wall stock 1.8 mm nominal, 1.4 mm minimum at the display recess to keep mass under 180 g.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Front face layout order top-to-bottom: recessed display window (46 x 22 mm) at 34% height, 12-slot round intake grille at 68% height, USB-C at 92% height with moulded chamfered lead-in; all three features are centred on the vertical axis and their moulded drafts are 2 degrees minimum.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Honest speckled aesthetic: single rABS grade with controlled regrind content and a dark speckle masterbatch, textured_light finish (VDI 27-30 equivalent), no gloss zones; batch-to-batch tonal variation is accepted as part of the brand story.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Cost and impact balance: no secondary decorative ops, no inserts, no gaskets, no separate light pipe; impact-modified rABS grade and 14 mm radii plus internal ribbing at snap bosses to survive the 1.0 m concrete drop assumption without adding mass.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This concept translates the B4 brief into a single rABS pebble shell that is warm, honest and visibly recycled. The pebble silhouette with a 14 mm corner radius softens the form so the speckled rABS reads as intentional material character rather than moulding defect. The mono-material, snap-fit architecture directly answers must-haves: no paint or coatings (laser-etch graphics only), screw-free disassembly with pry ledges and 4 cantilever snaps, and one plastic stream for recycling. The front face keeps a familiar, legible layout with display, intake and USB-C stacked on the centre axis, but the recessed display plateau and grouped round intake slots give the face a calm, product-specific rhythm. Cost stays inside the CNY 18 ceiling because there are no secondary ops, no inserts, no gaskets and no multi-shot tooling; the 100% rABS grade with impact modifier and speckle masterbatch is the only material spend. Mass and envelope hold margin under 125 x 75 x 30 mm and 180 g with 1.8 mm nominal walls and internal ribbing at the snap bosses. Residual risks are batch colour variation (accepted per C2 resolution) and snap durability under repeated opening (mitigated by cantilever design and impact-modified rABS, validated by drop test per C1)."
    },
