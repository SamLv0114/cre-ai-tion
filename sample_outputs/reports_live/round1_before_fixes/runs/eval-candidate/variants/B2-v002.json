    "concept": {
      "variant_id": "B2-v002",
      "brief_id": "B2",
      "direction": "soft_pebble",
      "name": "Pebble Grip Field Detector",
      "form_language": "A single soft pebble volume with no sharp edges: the whole shell reads as one continuous convex surface, top and bottom domed outward, sides drawn in by a shallow waist that the gloved hand finds without looking. The front face is slightly convex so it never sits perfectly flat, spilling dust and water off the display. Corner zones are thickened into moulded-in bumper pads that wrap the silhouette, so a drop lands on the pad, not the parting line. Geometry is intentionally simple: two main shells, one straight pull, no undercuts, so the soft form costs nothing extra at the tool.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 122.0,
        "width": 74.0,
        "height": 28.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 30.0
      },
      "display_window_mm": {
        "width": 42.0,
        "height": 19.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 72.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "PC-ABS",
        "finish": "textured_heavy",
        "color": "safety orange, Pantone 152C, UV-stabilised masterbatch, textured to hide scuffs and fingerprints",
        "secondary_ops": [
          "pad_print",
          "laser_etch",
          "tpe_overmold"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep PC-ABS as the shell material for impact and UV performance; rABS may only replace it if drop and ASTM G154 UV testing pass on the actual tool.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Preserve the pebble silhouette with a minimum 14 mm corner radius and moulded-in thick corner bumper pads at all four drop-prone corners; do not sharpen or thin the corners to gain internal volume.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Keep textured_heavy finish on all grip surfaces with TPE overmould pads on the left and right waists; texture depth and pad placement are the glove-friendly interface and must not be smoothed or deleted.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Retain the front-face intake as a gasketed, ePTFE-membrane-covered vent at x=50,y=72 percent; do not open the intake area or move it to a face that can be blocked by the hand.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Keep the USB-C port on the bottom face centre behind a captive tethered gasketed flap; the bottom-face location is what keeps the sealed port out of the rain path in handheld use.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Hold the high-visibility safety orange (Pantone 152C) with UV-stabilised masterbatch across all outer shells; do not substitute a darker or non-UV-stabilised colour for cost.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA7",
          "statement": "Protect the CNY 18 BOM ceiling by keeping the moulding to two main shells with a single straight pull and no side actions; any added slider or cosmetic insert must be traded against the ePTFE vent and gasket cost.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The pebble direction is the cheapest way to make a rugged handheld feel safe in a gloved hand: a continuous convex shell has no edges to catch, no thin ribs to crack, and a uniform 2.0-2.5 mm wall that spreads impact load. The 14 mm corner radius and moulded-in corner pads target the 1.5 m concrete drop without adding separate bumper parts, while the shallow waist and TPE overmould pads give a positive grip through work gloves. Sealing to IP65 is handled by a perimeter gasket in the parting line plus an ePTFE membrane over the front intake; the membrane costs about CNY 2.7 but is the only way to reconcile the required open intake area with IP65, and it is called out in IA4 so it is not value-engineered away. PC-ABS is specified rather than rABS because the brief's own conflict C1 flags rABS impact and UV risk; the rABS fallback is written into IA1 with a test gate. The bottom-face USB-C flap keeps the charging port out of the rain and out of the way of the display, and the convex front face sheds water off the window. At 122 x 74 x 28 mm and roughly 165 g with the 92 g internals, the concept sits inside the 125 x 75 x 30 mm envelope and the 180 g mass cap with margin for the gasket, membrane, and overmould. The two-shell, straight-pull architecture with no side actions is what keeps a durable, sealed, high-visibility housing at or under the CNY 18 BOM ceiling at 10,000 units per year."
    },
