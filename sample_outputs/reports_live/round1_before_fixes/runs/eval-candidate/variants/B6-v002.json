    "concept": {
      "variant_id": "B6-v002",
      "brief_id": "B6",
      "direction": "monolith_slab",
      "name": "Monolith Slab Air Detector",
      "form_language": "A single crisp chamfered slab, standing on a slight integrated kick-stand rear. The front face is dominated by a large, sunken display window framed by a continuous chamfer that catches light and makes the display look like a recessed aperture. The top face carries a subtle linear intake grille, flush with the surface, while the USB-C port sits on the rear face, hidden from the user's view. Generous radii and a light texture give a friendly, approachable character without looking toy-like.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 118.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 6.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 45.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 24.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 40.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 65.0
      },
      "cmf": {
        "material": "ABS",
        "finish": "textured_light",
        "color": "Warm light grey (RAL 7035 equivalent, slight yellow tint)",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Maintain the 6 mm chamfer around the display window; it defines the monolith slab look and protects the display edge from impact.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Keep the display window at least 58 mm wide with high contrast (dark background, light text) to meet readability from 1.5 m.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "The top intake grille must be a linear slot pattern with slot width 1.2 mm and pitch 3 mm, recessed 0.5 mm, to allow airflow while hiding internal components.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Use textured_light finish on all visible surfaces to hide fingerprints and reduce glare.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C port on rear face, centred horizontally, with a 0.3 mm recess to prevent damage to the connector during blind mating.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept adapts the DFM-safe reference by increasing display size for better readability (IA2) and adding a top intake to separate air paths from user handling. The chamfered_slab silhouette with 6 mm chamfers gives a friendly yet robust appearance, while the textured_light finish meets the fingerprint-hiding requirement. Material choice of ABS balances cost and durability, with pad_print for branding and laser_etch for functional icons. The 118x72x28 mm envelope stays within the 125x75x30 mm limit and the estimated mass is ~130 g, well under 180 g. The design uses no secondary ops that would push cost beyond the CNY 18 ceiling, and the intake slots are sized to avoid tooling issues. Overall, it fulfills the brief's balanced priorities."
    },
