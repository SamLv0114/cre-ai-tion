    "concept": {
      "variant_id": "B3-v002",
      "brief_id": "B3",
      "direction": "monolith_slab",
      "name": "Slab Monolith Air Detector",
      "form_language": "A single calm chamfered slab, furniture-like and monolithic, with a continuous fine-matte shell and no visible fasteners. The front face is a clean dark display band framed by a narrow warm-grey bezel; a subtle 12\u00b0 chamfer runs around the top edge to catch light and separate the product from the sideboard. The top face carries a fine hidden intake grid, flush and low-contrast, while the rear-bottom edge has a small recessed USB-C port for occasional charging. The overall read is slim, quiet, and premium \u2014 an object that disappears into a living room until looked at.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 120.0,
        "width": 70.0,
        "height": 28.0
      },
      "corner_radius_mm": 8.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 52.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 24.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 22.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm mineral grey (RAL 7038-adjacent), with a charcoal display bezel",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the front display window at 58 x 24 mm centered, with a high-contrast dark bezel, so readings are legible from 2\u20133 m on a sofa.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Preserve the monolithic chamfered-slab silhouette: single body, no visible split lines on front/top, all fasteners hidden on the underside or behind the rear USB recess.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Maintain a fine-matte textured_light finish on all visible surfaces; avoid gloss, heavy texture, or high-contrast two-tone splits that break the calm furniture read.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Keep the top intake as a fine, flush, low-contrast grid no deeper than 0.8 mm and no wider than 40% of the top face, so it reads as a quiet detail rather than a vent.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Hold the rABS shell and total envelope at or below 120 x 70 x 28 mm and 180 g, preserving the slim sideboard-friendly proportion.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Use snap-fit or captive-screw assembly with no more than four screws, all accessible from the underside, to support basic disassembly and rABS recycling.",
          "category": "sustainability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept adapts the tooling-approved rounded_rect reference into a more furniture-like chamfered slab. The 120 x 70 x 28 mm envelope stays inside the 125 x 75 x 30 mm contract and keeps the mass low enough for the 180 g limit, leaving roughly 88 g for the rABS shell after the ~92 g internals. The 58 x 24 mm front window is deliberately larger than the reference 44 x 20 mm to satisfy the 2\u20133 m sofa-viewing assumption without adding height. Moving the intake to the top face frees the front for a single calm display band and supports the monolith direction; the USB-C port is recessed into the rear-bottom edge so it is invisible from normal seating angles. The rABS material and textured_light finish meet the sustainability and soft-touch/fine-matte priorities while staying inside the CNY 18 BOM ceiling, since no separate soft-touch coating is required and pad_print/laser_etch are low-cost secondary ops. Snap-fit plus four underside screws keep assembly simple and support the Q3 default disassembly assumption. The 8 mm corner radius and 12\u00b0 top chamfer are both mouldable at this wall thickness and keep the part DFM-safe."
    },
