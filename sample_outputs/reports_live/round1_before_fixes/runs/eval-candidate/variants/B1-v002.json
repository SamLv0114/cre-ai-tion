    "concept": {
      "variant_id": "B1-v002",
      "brief_id": "B1",
      "direction": "monolith_slab",
      "name": "Chamfered Monolith Desk Detector",
      "form_language": "A single low-slung rectangular slab with a continuous 45\u00b0 chamfer running around the top and bottom edges; the chamfer reads as a crisp, tool-friendly reveal rather than a soft radius. The front face is deliberately plain: one flush rectangular display window centred slightly high, a small printed logo low-right of centre, and no other ornament. Air enters through a shallow, wide louvre band recessed into the top face near the rear edge, hidden from normal view so the front stays clean. A single USB-C port sits centred on the rear face, recessed behind a small chamfered lip. The two-part shell is split on a horizontal plane at mid-height, with the top cover sitting inside the lower tub lip so the joint line is a thin shadow gap; all walls are kept at a uniform 1.8\u20132.0 mm to keep cycle time and weight down.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 118.0,
        "width": 68.0,
        "height": 27.0
      },
      "corner_radius_mm": 4.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 42.0,
        "height": 18.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "dark slate grey, NCS S 7500-N equivalent, matte low-sheen",
        "secondary_ops": [
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the 45\u00b0 chamfer continuous around the top and bottom perimeter; it is the only form feature and must not be replaced by a large radius, because the sharp chamfer is what lets a budget single-slide tool cut the part without side actions.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Keep the top-cover / bottom-tub split on a horizontal plane at mid-height with a 0.5 mm shadow-gap lip; do not move the split to the front face or add a visible light pipe, as this would add a second tool action and break the plain front.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Preserve the recessed top intake louvre band at the rear of the top face; it must stay outside the footprint of the internal fan and sensor stack so the front face remains free of grille holes.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Use rABS with a light VDI 24 texture and a dark slate grey colour; this combination is the scuff- and fingerprint-hiding CMF specified by the brief and must not be swapped for gloss or a light colour.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Keep the display window as a single flush rectangular aperture 42 \u00d7 18 mm with no bezel overhang or separate lens; a bonded lens would add cost and break the CNY 12 target.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Keep the USB-C port centred on the rear face and recessed behind a small chamfered lip; the rear placement keeps the front elevation clean and avoids a second visible opening on the front.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "This variant adapts the approved rounded-rectangle reference to the monolith_slab direction by swapping the 8 mm radius for a 4 mm corner radius plus a 45\u00b0 edge chamfer. The chamfer is deliberately tool-friendly: it is a straight-line cut around the perimeter, so the part can be moulded in a simple two-plate tool with no side actions, which protects the CNY 12 housing target and the budget-tooling requirement. The envelope is slightly smaller than the reference (118 \u00d7 68 \u00d7 27 mm vs 116 \u00d7 66 \u00d7 27 mm) to keep the mass under 180 g with the ~92 g internals. The front face is kept deliberately plain: one flush display window, one small pad-printed logo, and no grille. Air enters through a recessed louvre band on the top face near the rear edge, which is both out of sight in normal desk use and easy to core out with a simple slide. The USB-C port is moved to the rear face so the front stays a clean monolith. CMF is the brief's default: rABS with a light VDI 24 texture in dark slate grey, which hides scuffs and fingerprints and is the lowest-cost material on the allowed list. The two-part shell uses a mid-height horizontal split with a 0.5 mm lip, which is the cheapest reliable assembly for 10k units/year and keeps the joint line visually quiet. All intent anchors protect decisions that either keep the tool simple or keep the front elevation plain, because both are what allow this design to hit the cost target while still looking tidy."
    },
