    "concept": {
      "variant_id": "B5-v001",
      "brief_id": "B5",
      "direction": "soft_pebble",
      "name": "Pebble Air",
      "form_language": "Soft pebble-like monoblock with continuous convex surfaces and no visible parting line on the front face; generous 12 mm corner radii create a smooth, hand-friendly form. The front face is subtly domed to 1.5 mm crown for rigidity. Intake is expressed as a recessed micro-perforated band with 0.6 mm holes at 1.2 mm pitch, arranged in a rounded-rectangle pattern that follows the pebble contour. Display sits in a dark, flush glass window with a 0.5 mm black border printed on the underside. USB-C port is recessed 0.8 mm into a small chamfered pocket on the bottom edge, sealed by an integrated TPU flap. The overall expression is premium, calm, and waterproof, with soft-touch matte paint in deep charcoal.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 125.0,
        "width": 75.0,
        "height": 26.0
      },
      "corner_radius_mm": 12.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 32.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 82.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "smooth_matte",
        "color": "Deep Charcoal (Pantone 19-3906 TCX) with soft-touch matte clear coat",
        "secondary_ops": [
          "soft_touch",
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Front face must remain free of visible screws or parting lines; all assembly is from the rear, and the front is a continuous soft-pebble surface with 12 mm corner radii.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Intake must be a micro-perforated recessed band on the front face, with holes 0.6 mm diameter at 1.2 mm pitch, covering at least 15% open area, backed by an ePTFE membrane for IP67.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "USB-C port on the bottom face is sealed by an integrated TPU flap that must maintain IP67 when closed; the flap is captive and recessed 0.8 mm.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Housing material is 100% recycled ABS (rABS) with a soft-touch matte paint system that includes a primer for adhesion to rABS; no virgin plastic anywhere in the housing.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Display window is a flush, dark glass insert with a 0.5 mm black printed border; the window must be bonded with a gasket or adhesive that maintains IP67.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Total housing BOM must stay at or below CNY 18 per unit at 10k units/year; the ePTFE vent and gasket add ~CNY 2.7, so tooling and paint must be optimized accordingly.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The soft_pebble direction resolves the hard conflicts by adopting the relaxed envelope (125x75x26 mm) and mass (180 g), which are already accepted in the contract. The pebble silhouette with 12 mm corner radii provides a premium, hand-friendly form that differentiates in the air-quality detector market. A front-face intake with micro-perforations maintains the required open area while the ePTFE membrane behind it ensures IP67. The USB-C flap on the bottom face keeps the front clean and preserves the pebble aesthetic. Material is rABS to meet the 100% recycled requirement, and the soft-touch matte paint is specified with a primer to address adhesion on rABS. The display is flush glass with a printed border, contributing to the premium look. All intent anchors are chosen to lock in the critical design decisions that downstream engineering must not lose: front-face cleanliness, intake performance, USB sealing, material sustainability, display integration, and cost ceiling. This concept is feasible within the relaxed constraints and aligns with the brief's priorities of cost, durability, aesthetics, and sustainability."
    },
