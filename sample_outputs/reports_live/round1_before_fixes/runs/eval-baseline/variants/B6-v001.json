    "concept": {
      "variant_id": "B6-v001",
      "brief_id": "B6",
      "direction": "soft_pebble",
      "name": "Pebble Air \u2014 Soft Desk Sentinel",
      "form_language": "A gently inflated pebble silhouette: the 125 x 75 x 30 mm slab is softened by a continuous 9 mm edge radius so no hard line meets the desk, and a subtle crown on the front face (1.5 mm rise at centre) gives the body a calm, breath-like volume. The pebble reads as a single friendly object rather than a technical box; the only interruption is the wide display window, which is inset 0.8 mm and framed by a 1.2 mm cosmetic chamfer, so the screen appears to float inside the stone. A shallow radiused ridge runs around the lower third to suggest a resting base without adding a second material.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 124.0,
        "width": 74.0,
        "height": 29.5
      },
      "corner_radius_mm": 9.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 54.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 34.0
      },
      "intake": {
        "face": "front",
        "x_pct": 18.0,
        "y_pct": 82.0
      },
      "usb": {
        "face": "front",
        "x_pct": 82.0,
        "y_pct": 82.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Warm oat white (RAL 9001-adjacent, 5% warm bias), with a dark slate grey display bezel and a soft-touch accent ring",
        "secondary_ops": [
          "soft_touch",
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the front face single-plane with a 1.5 mm crown and 9 mm perimeter radius; do not add a separate bezel part, the display must be inset into the pebble surface.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Display window is 58 x 34 mm, centred horizontally and placed so its centre sits at 54% of face height; this is the minimum legibility envelope for reading from 1.5 m.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Intake and USB-C are mirrored at 18% / 82% face width and at 82% face height, leaving the lower centre free for a pad-printed product mark; keep this symmetry so the device can be used either way up.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Housing material is rABS with textured_light MT-11010 finish (SPI B-2 equivalent) at 0.8\u20131.2 mm wall; this hides fingerprints and keeps part cost within the CNY 18 ceiling.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Use snap-fit assembly for the front and rear shells; no screws on the visible front face, preserving the friendly pebble read and reducing part count.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Secondary ops are limited to a soft-touch accent ring and pad printing; do not add IML, paint, or laser etching, to stay within the CNY 18 BOM ceiling.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The soft_pebble direction is resolved as a desk-standing air-quality detector that looks approachable rather than clinical. The 124 x 74 x 29.5 mm envelope uses the full length and width budget while staying under the 30 mm height, and the 9 mm corner radius is the largest that still leaves a flat 58 x 34 mm display window on the front face. Placing the display at 54% of face height puts it near eye level for a seated user and keeps the lower third free for the intake and USB-C, which are mirrored at 18% / 82% width so the device reads correctly from either side of a desk. The intake is a single front-face grille at 82% height, avoiding a bottom intake that would be blocked by papers or a desk mat. rABS with textured_light finish directly addresses the brief's fingerprint-hiding must-have and the sustainability priority (30% recycled content), while a single snap-fit tool with no screws keeps part cost inside the CNY 18 ceiling. The warm oat white colour and soft-touch accent ring carry the friendly, office-appropriate aesthetic without adding a second moulded part."
    },
