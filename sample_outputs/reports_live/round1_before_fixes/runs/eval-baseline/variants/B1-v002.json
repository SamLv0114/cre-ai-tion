    "concept": {
      "variant_id": "B1-v002",
      "brief_id": "B1",
      "direction": "monolith_slab",
      "name": "Slab Monolith Desk Detector",
      "form_language": "Single-volume chamfered slab, 118 x 72 x 26 mm, dominated by one large flat top plane and a continuous 2.5 mm 45-degree chamfer running the whole perimeter; the chamfer is the only formal gesture and reads as a machined edge rather than a styling line. Front face is a plain rectangular field with the display recessed flush left-of-centre and the printed logo only on the top face. Intake is a single straight row of slots along the top face, kept out of the chamfer so the tooling stays simple. USB sits on the right side wall as a plain rectangular cut-out, hidden from the front view. No part lines on the front face: the two-part shell splits on the perimeter chamfer, so the seam reads as a shadow line, not a joint. Proportions are a true slab, wider than tall, so it sits low on a desk like a small instrument, not like a consumer gadget.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 118.0,
        "width": 72.0,
        "height": 26.0
      },
      "corner_radius_mm": 2.5,
      "display": {
        "face": "front",
        "x_pct": 38.0,
        "y_pct": 52.0
      },
      "display_window_mm": {
        "width": 34.0,
        "height": 18.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "ABS",
        "finish": "textured_light",
        "color": "Dark warm grey, NCS S 7005-B20G equivalent, opaque, no gloss additives",
        "secondary_ops": [
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the two-part shell split on the perimeter chamfer so the front face stays a single unbroken moulded plane; the seam must read as a shadow line, not a visible joint.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Display is a flush rectangular window 34 x 18 mm at 38% width / 52% height on the front face; no bezel, no raised surround, no touch cover.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Intake is one straight row of slots on the top face, outside the chamfer band, so the tooling uses a single straight slider and no side actions.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Material is standard ABS with a light texture (MT-11010 equivalent, 12-15 micron) in dark warm grey; no soft-touch, no gloss, no secondary paint.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Wall thickness 2.0 mm nominal, ribs only at the four corner bosses; housing mass target 118 g so the 180 g ceiling holds with margin.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Chamfer is a constant 2.5 mm 45-degree band so the part can be moulded in a two-plate tool with a straight pull and no lifters.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "The monolith slab direction is pursued literally: one chamfered block, one front face, one top slot row. This is the cheapest credible geometry for 10k units/year because it needs a two-plate tool only, no side actions, no separate bezel, and no secondary decoration beyond a pad-printed logo. Placing the display flush at 38% width keeps the right half of the front face as plain moulded surface, which is where the eye reads material quality, and it leaves room on the left for the logo print without crowding. The top-face intake keeps the front face clean and the slot row can be cut with a straight slider, avoiding the cost of a lifter. The USB on the right side wall removes it from the front composition and keeps the front face pure. The dark warm grey textured ABS answers the scuff-hiding and fingerprint-resistance must-haves: a light texture scatters reflections and hides hairline scratches, and the mid-dark value hides fingerprints and desk dirt. The 2.0 mm wall and corner-boss-only ribbing keeps mass at roughly 118 g, leaving headroom under the 180 g ceiling for the 92 g internals. Cost sits at the floor of the contract: single material, single finish, one pad print, two-plate tool. The main risk is the budget conflict C1; this concept addresses it by removing every optional feature rather than by compromising the enclosure, so if cost still exceeds CNY 12 the next lever is tooling amortisation, not the design."
    },
