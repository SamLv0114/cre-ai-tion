    "concept": {
      "variant_id": "B6-v002",
      "brief_id": "B6",
      "direction": "monolith_slab",
      "name": "Monolith Slab Desk Air-Quality Detector",
      "form_language": "A slim, monolithic chamfered slab that reads as a single calm volume on the desk. The front face is a clean vertical plane framed by a 2.5 mm chamfer that catches light and softens the silhouette. A single large, high-contrast display window dominates the front, set in a shallow recess with a 1.5 mm bezel so it appears flush and readable from a neighbouring desk. The top face carries a subtle intake grille of parallel micro-slots, visually separated from the display by a thin horizontal break line. The rear is plain with a small recessed USB-C port at the lower right, keeping the front and top surfaces free of clutter. The chamfered slab silhouette is friendly and approachable through generous corner radii and a light, matte texture that hides fingerprints. Overall proportion is wide and low, stable on a desk and visually light.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 125.0,
        "width": 75.0,
        "height": 30.0
      },
      "corner_radius_mm": 8.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "display_window_mm": {
        "width": 72.0,
        "height": 34.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 60.0
      },
      "usb": {
        "face": "back",
        "x_pct": 80.0,
        "y_pct": 30.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Warm off-white (RAL 9010) with a subtle warm grey undertone",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Maintain the slim monolithic chamfered slab silhouette with an 8 mm corner radius and a 2.5 mm front chamfer so the product reads as a single calm volume rather than a boxy appliance.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Preserve the large front display window (72 x 34 mm) centred on the front face so readings are legible at a glance from a neighbouring desk.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Keep the top-face intake grille as parallel micro-slots positioned above the display break line, ensuring no visual or functional interference with the display bezel.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Use rABS with a light matte texture and warm off-white colour to deliver fingerprint hiding, a friendly office aesthetic, and a sustainability benefit within the CNY 18 BOM ceiling.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Keep the USB-C port recessed on the back face at the lower right, avoiding any front-face disruption and preserving the clean monolithic front.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept follows the monolith_slab direction by using a slim chamfered slab that fits within 125 x 75 x 30 mm and 180 g. The wide, low proportion with an 8 mm corner radius and a 2.5 mm front chamfer creates a friendly, approachable object. The front-face display window is oversized at 72 x 34 mm to meet the 'readable at a glance' must-have, while the top-face intake keeps the front clean and allows natural convection. The rear USB-C placement avoids visual clutter. rABS with a light matte texture satisfies the fingerprint-hiding and sustainability priorities, and pad printing plus laser etching provide low-cost branding and interface marks within the CNY 18 BOM ceiling. The design uses no secondary paint or overmoulding, keeping cost and mass low while retaining durability for standard office handling."
    },
