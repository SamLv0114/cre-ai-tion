    "concept": {
      "variant_id": "B3-v001",
      "brief_id": "B3",
      "direction": "soft_pebble",
      "name": "Soft Pebble Air-Quality Detector",
      "form_language": "A single continuous pebble volume: the front face reads as one calm, slightly crowned plane with no visible parting line or fasteners, wrapping into generously radiused flanks so the object looks pressed rather than assembled. The front is organised as a quiet horizontal band: a wide display window sitting high and centred, a fine micro-perforated intake field below it, and a single recessed USB-C notch centred on the bottom edge. All edges are soft and shadowless; the mass reads furniture-like on a shelf, and the slim 26 mm depth keeps the pebble from becoming a blob.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 125.0,
        "width": 75.0,
        "height": 26.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 32.0
      },
      "display_window_mm": {
        "width": 72.0,
        "height": 34.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 70.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm grey (NCS S 4005-Y20R) body with a darker charcoal screen bezel and tone-on-tone micro-perforation",
        "secondary_ops": [
          "soft_touch",
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the pebble silhouette as one continuous crowned front plane with no visible parting line or fasteners on any face the user sees at sofa height; all screw bosses stay on the hidden rear/bottom joint.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Preserve the front-face band layout: display window centred at 50% width / 32% height, intake field centred at 50% width / 70% height, and a single USB-C notch centred on the bottom edge (50/50) so the front reads as a calm two-zone composition.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Hold the display window at 72 x 34 mm minimum with high-contrast, large-numeral UI so readings are legible from 2.5-3 m across a living room.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Use a fine-matte textured_light rABS body with a soft-touch coating of good abrasion resistance; no gloss highlights, no visible gate marks or sink on the front plane.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Keep the intake as a tone-on-tone micro-perforated field that does not read as a grille; it must not break the calm front plane or add a separate part.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Respect the cost and mass budget: rABS mono-material body, single soft-touch application, no inserts or metal trim; target <=180 g and <=CNY 18 housing BOM.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The soft_pebble direction turns the detector into a quiet object rather than an appliance. A 125 x 75 x 26 mm pebble with a 14 mm corner radius sits under the 30 mm thickness cap while leaving room for a 72 x 34 mm display, which meets the 2.5-3 m sofa reading assumption (Q1) with margin. Placing display and intake on the same front plane keeps the user-facing surface unbroken, so hidden fasteners move to the rear and bottom, satisfying the brief's hidden-fastener must-have. rABS with a textured_light finish and soft-touch coating answers the sustainability priority and the fine-matte furniture aesthetic (Q3), while tone-on-tone micro-perforation avoids a utilitarian grille look. The single USB-C notch on the bottom edge disappears from normal viewing angles, protecting the calm front. All decisions stay inside the CNY 18 ceiling and 180 g mass cap; the only open risk is soft-touch abrasion resistance under cleaning (Q2), mitigated by specifying an abrasion-resistant coating rather than a standard one."
    },
