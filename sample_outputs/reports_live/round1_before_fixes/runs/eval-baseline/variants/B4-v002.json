      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 75.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 40.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Warm Natural Grey with visible dark speckles",
        "secondary_ops": []
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Use only rABS for the entire housing, including the display window frame; no other plastic materials allowed.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Housing must be assembled via snap-fit or living hinge, with no screws, adhesives, or coatings.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Maintain a light textured finish on all external surfaces to mask rABS surface imperfections and provide a warm, non-glossy appearance.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "The front face must have a recessed display window area with a snap-in clear rABS lens (if needed) to protect the display while maintaining mono-material integrity.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "The top intake should be a series of small slots or holes, positioned to avoid direct water ingress, and sized to prevent finger ingress while allowing airflow.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "The side USB port must be recessed with a chamfered surround to protect the connector and allow easy access.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA7",
          "statement": "Wall thickness minimum 2.0mm, with internal ribs for rigidity, to compensate for rABS lower impact strength.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept embraces the brief's sustainability ethos by using a mono-material rABS housing with no secondary operations, ensuring easy recycling and repair. The chamfered slab silhouette is both modern and robust, with generous corner radii to prevent stress concentrations and improve drop performance. The light texture provides a warm, honest appearance that hides flow lines and specks typical of recycled material. The display is recessed to protect it, and the top intake is integrated into the form without compromising the clean look. The USB port on the right side is accessible yet protected. The overall size is within the envelope, and the mass can be kept under 180g by minimizing wall thickness while using ribs for strength. The snap-fit design, though more complex than screws, aligns with the screw-free disassembly requirement; careful latch design will ensure durability. The estimated cost remains within the CNY 18 ceiling by avoiding extra materials and processes."
    },
