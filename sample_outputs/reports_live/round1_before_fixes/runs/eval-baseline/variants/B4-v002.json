    "concept": {
      "variant_id": "B4-v002",
      "brief_id": "B4",
      "direction": "monolith_slab",
      "name": "Reclaimed Slab",
      "form_language": "A monolithic chamfered slab with a confident, durable presence. The front face is flat with a subtle 0.5mm recessed perimeter, emphasizing precision and honesty of material. The top surface slopes gently upward toward the back, accommodating the intake and providing a natural resting angle. The chamfers are wide (4mm) at 45 degrees, creating a soft, tactile edge that feels premium yet purposeful. The overall expression is warm, grounded, and inherently recyclable.",
