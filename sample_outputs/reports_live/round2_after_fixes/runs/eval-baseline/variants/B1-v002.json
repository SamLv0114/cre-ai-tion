    "concept": {
      "variant_id": "B1-v002",
      "brief_id": "B1",
      "direction": "monolith_slab",
      "name": "Monolith Slab Detector \u2014 Chamfered Two-Part Shell",
      "form_language": "A single horizontal monolith: one flat-fronted chamfered slab with a continuous 8 mm 45\u00b0 chamfer running the full perimeter of the front bezel and the rear cover, so the part reads as a solid block rather than a boxed appliance. Vertical parting line sits at the widest point of the side wall so both mould halves are simple open-shut tools with no side action. Front face is deliberately blank except for a recessed smoked display window in the upper third and a single low-contrast pad-printed logo in the lower right. Top face carries a gently recessed intake grille of parallel slots; the rear-bottom edge has a shallow USB-C cut-out. No ribs, no bezels, no gloss break-up: form is carried entirely by the chamfer and the light texture.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 122.0,
        "width": 74.0,
        "height": 29.0
      },
      "corner_radius_mm": 6.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 28.0
      },
      "display_window_mm": {
        "width": 52.0,
        "height": 22.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Dark warm grey, Pantone 419 C equivalent, matte moulded-in (L*\u224828, low gloss ~6-8 GU at 60\u00b0)",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Keep the perimeter chamfer at 8 mm x 45\u00b0 running continuously around front bezel and rear cover; this single feature replaces all other styling and must not be softened into a radius or removed for cost.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Maintain the vertical parting line at the widest side-wall point with a plain open-shut tool: no side cores, no lifters, no undercuts anywhere on the housing.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Keep the front face blank apart from the recessed display window and one low-contrast pad-printed logo; do not add badging, LED rings, speaker slots or decorative inserts.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Retain the moulded-in light texture on all visible rABS surfaces at the specified matte gloss band so scuffs and fingerprints stay invisible; no secondary paint or soft-touch coating.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Preserve the rABS material choice and uniform 2.2 mm wall with snap-fit rib engagement and no screws, keeping the two-part shell cost inside the CNY 12 housing target.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Keep the top-face intake as a shallow recessed parallel-slot grille moulded directly into the shell, with no separate mesh part or insert.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "The monolith_slab direction is answered with a chamfered_slab silhouette that costs almost nothing to tool: the 8 mm x 45\u00b0 chamfer is a single continuous surface that stiffens the front bezel, hides the parting line shadow, and gives the product a deliberate, tidy retail presence without any added parts. Keeping the parting line vertical and at the widest point lets both halves pull in a straight line, so budget single-cavity tools can be used and the C1 cost conflict is addressed by eliminating slides, screws and secondary decoration. rABS with a light moulded-in texture and a dark warm grey colour satisfies the scuff-hiding and fingerprint-resistant must-haves while staying inside the allowed material list. The top intake and bottom USB keep the front face clean, which protects the plain aesthetic and makes the display the only focal point. At 122 x 74 x 29 mm the envelope stays under 125 x 75 x 30 mm with material to spare for the 2.2 mm wall, and the estimated shell mass of ~78 g keeps total product mass near 170 g, below the 180 g limit. The pad-printed logo is the only decoration, matching the brief's 'printed logo only' constraint while the laser-etched serial on the rear cover adds traceability at negligible cost."
    },
