    "concept": {
      "variant_id": "B4-v001",
      "brief_id": "B4",
      "direction": "soft_pebble",
      "name": "PebbleAir Mono",
      "form_language": "Soft pebble-like rounded volume with an all-over gentle curvature, no sharp edges; a slim, warm, honest block that reads as a single continuous surface. The front face carries a large, softly recessed display window, while the lower front is a subtly dished intake field with a fine, evenly distributed micro-perforation pattern to express the speckled recycled material without any applied graphics. A shallow, hand-friendly side seam line divides upper and lower shells and doubles as the screw-free snap-fit parting line, with small pry notches at the rear corners for repair access.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 122.0,
        "width": 74.0,
        "height": 28.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 24.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Natural warm grey with visible darker speckles (no added colorant; PCR-dependent tone)",
        "secondary_ops": []
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Housing is mono-material rABS with zero paint, lacquer or soft-touch coating; the speckled surface is the material itself, not a printed or painted effect.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Screw-free disassembly via hidden snap-fit tabs along the parting line plus two rear pry notches, tool-openable and rated for at least 10 open/close cycles without loss of retention.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Slim pebble silhouette: envelope stays within 122 x 74 x 28 mm and corner radius stays at 14 mm, keeping the warm, hand-friendly rounded volume without a flat slab look.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Front-face layout hierarchy: display window centred at 38% height, intake micro-perforation field centred at 78% height, separated by an uninterrupted 4 mm minimum wall band to preserve structural durability and air-path separation.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Wall thickness held to 2.0-2.4 mm nominal and ribbing kept internal, so the 10k/year injection-moulded part stays within the CNY 18 BOM ceiling with a single 2-plate tool per shell.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This concept resolves the brief's core tension (C1) by treating the parting line as both an aesthetic feature and the screw-free service joint: hidden snap-fits along a 14 mm rounded perimeter give repeated open/close access while the pebble form distributes impact loads and helps the 1 m drop assumption. Mono-material rABS with a light texture and no secondary ops satisfies the sustainability priority and keeps the speckled, honest look; the front layout keeps display and intake visually separated without extra parts. The slim 28 mm height and 2.0-2.4 mm walls keep mass under 180 g and tooling simple enough for the CNY 18 ceiling at 10,000 units/year."
    },
