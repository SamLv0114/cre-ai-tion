    "concept": {
      "variant_id": "B3-v002",
      "brief_id": "B3",
      "direction": "monolith_slab",
      "name": "Monolith Slab Air Detector",
      "form_language": "A single, calm, chamfered slab that reads as a quiet piece of furniture rather than a gadget. The front face is a continuous, unperforated plane interrupted only by a flush, recessed display window; the top face carries the intake as a fine, horizontal slot array that disappears into the chamfer shadow. Side walls are near-vertical with a subtle 2\u00b0 draft, soft 1.5 mm chamfers on all edges, and a continuous parting line at the lower third so the upper shell can be one clean moulding. A shallow recessed foot band on the bottom gives the object a floating stance. No visible screws, no logos on the front face, no glossy accents.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 125.0,
        "width": 75.0,
        "height": 30.0
      },
      "corner_radius_mm": 3.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 42.0
      },
      "display_window_mm": {
        "width": 62.0,
        "height": 24.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 55.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 40.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Warm off-white (NCS S 1002-Y, ~RAL 9010 adjusted warmer) with a matching warm-grey lower shell; display window bezel in\u2026",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Front face must remain a single unperforated plane; the only interruption is the flush display window. No speaker grilles, logos, or fasteners on the front.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Intake is a horizontal slot array on the top face, set back from the front edge so it is not visible from a normal standing or seated eye height; slot width and pitch must read as a fine texture, not a grille.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Display window is 62 x 24 mm, centred horizontally, with its optical centre at 42% of front-face height; this geometry is tuned for readability at 2.5\u20133 m and must not be shrunk or moved without re-validating legibility.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "All fasteners are hidden: upper and lower shells join via internal snap fits and a single concealed screw under the rear foot pad. No visible screws, no adhesive on the main seam.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Housing material is rABS with a light mould texture (VDI 27\u201330 equivalent) on all cosmetic surfaces; no secondary soft-touch coating, no gloss, no paint on the main shells.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Wall thickness nominal 2.0 mm, ribs at 1.2 mm, and a 2\u00b0 draft on all vertical walls; the 3 mm edge chamfer and 1.5 mm internal radii are the minimum that still read as 'soft' at arm's length.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The monolith_slab direction is resolved as a chamfered slab with a fully blank front face: at 2.5\u20133 m the display is the only thing the user needs to read, so everything else is suppressed. Putting the intake on the top face keeps the front plane uninterrupted and uses the top chamfer as a natural shadow line that hides the slot array from seated eye height. The 62 x 24 mm window at 42% height gives a large enough character height for a 2\u20133 m read while keeping the front proportion calm. rABS with a light mould texture hits the sustainability priority and the 'fine matte' brief at zero secondary-coating cost, and the two-shell snap-fit architecture keeps tooling and assembly inside the CNY 18 ceiling at 10k/year. The warm off-white colour and matching lower shell prevent the object from reading as a plastic box, supporting the furniture-like intent."
    },
