        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "smooth_matte",
        "color": "Warm Grey (Pantone 2331 C)",
        "secondary_ops": [
          "soft_touch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "The pebble silhouette with continuous curvature and no sharp edges must be preserved to maintain the premium soft-touch aesthetic.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "The front face layout: display centered at 40% height, intake grille below at 80% height, ensuring unobstructed airflow and user visibility.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Soft-touch paint only on visible exterior surfaces; sealing areas must remain unpainted for gasket adhesion and ultrasonic welding.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Use 100% recycled ABS (rABS) with smooth matte finish to meet sustainability and cost targets.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C port on bottom edge, centered and recessed to maintain IP67 sealing with a gasketed cover.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "This concept balances the premium soft-touch aesthetic with the relaxed constraints of the design contract. The pebble silhouette and smooth matte finish deliver a high-end feel while the rABS material and soft-touch paint meet sustainability and cost targets. The front layout places the display prominently and the intake grille below, ensuring functionality. The USB-C port on the bottom allows for easy access while maintaining IP67 sealing through a gasketed cover. The 12 mm corner radius enhances the soft, rounded form. Intent anchors preserve critical design decisions for downstream engineering."
    },
