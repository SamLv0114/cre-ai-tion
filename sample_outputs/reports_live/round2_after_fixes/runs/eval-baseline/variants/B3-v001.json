    "concept": {
      "variant_id": "B3-v001",
      "brief_id": "B3",
      "direction": "soft_pebble",
      "name": "Soft Pebble Slim Air-Quality Detector",
      "form_language": "Pebble-like continuous surfacing with no visible parting line on the front face; gently domed front and back shells separated by a thin shadow gap at the mid-height. All edges are softly radiused so the housing reads as a smooth river stone. The display is a flush black window with a rounded-rectangle mask, sitting slightly above the front surface to stay readable from 2.5-3 m. Intake is a single horizontal micro-slot band recessed into the lower front, with hidden snap-fit assembly and no exposed screws.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 120.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 12.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 58.0,
        "height": 22.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 82.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm stone grey, PMS 413 C equivalent, with soft-touch matte appearance achieved by fine mold texture only",
        "secondary_ops": [
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Preserve the pebble silhouette: continuous, fully radiused perimeter with no sharp edges or flat side walls; corner radius must remain >= 10 mm in all views.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Keep the display window readable from 2.5-3 m: minimum 58 x 22 mm active window, high-contrast black mask, and a viewing angle of at least 45 degrees in the vertical plane.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Maintain hidden fasteners: no visible screws or clips on any external face; use internal snap fits and a recessed USB-C opening on the back face only.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Retain the fine matte surface as a mold-texture finish (VDI 27 equivalent) rather than a secondary soft-touch coating, to stay within the CNY 18 BOM ceiling.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Use rABS as the primary shell material to support the sustainability priority, with basic snap-fit disassembly and no adhesives on the main parting line.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Keep the front intake as a single recessed horizontal micro-slot band below the display, protecting the sensor from direct dust and preserving the calm front face.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "The soft pebble direction expresses calm, minimal, furniture-like values through a fully radiused, seamless shell that sits quietly on a shelf or side table. At 120 x 72 x 28 mm the envelope stays under the 125 x 75 x 30 mm limit, and the slim profile is reinforced by a shallow 28 mm height. The front face carries only two elements: a 58 x 22 mm display window at 38% height for sofa readability, and a recessed intake slot at 78% height that keeps the sensor low and hidden. USB-C is placed on the back face at 82% height, out of sight in normal use. rABS with a fine mold texture meets the sustainability and cost priorities without a secondary coating, while a single pad-printed wordmark on the back keeps the front clean. Internal snap fits and a shadow-gap parting line achieve hidden fasteners and basic disassembly, aligning with the brief's assumptions Q2 and Q3."
    },
