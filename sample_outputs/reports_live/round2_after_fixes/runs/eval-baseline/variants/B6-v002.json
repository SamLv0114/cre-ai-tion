    "concept": {
      "variant_id": "B6-v002",
      "brief_id": "B6",
      "direction": "monolith_slab",
      "name": "Monolith Slab Desk Detector",
      "form_language": "A single confident chamfered slab: the front face is one uninterrupted plane carrying only the display, the top edge is a gentle 12\u00b0 chamfer that hosts the intake, and the base is a thin shadow-gap plinth. All functional interfaces are concentrated on the front and top so the silhouette reads as a calm, friendly monolith from across an open-plan desk. Chamfers replace fillets where possible to reduce tooling cost while keeping the object approachable.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 125.0,
        "width": 30.0,
        "height": 75.0
      },
      "corner_radius_mm": 4.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 42.0
      },
      "display_window_mm": {
        "width": 78.0,
        "height": 40.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "back",
        "x_pct": 50.0,
        "y_pct": 30.0
      },
      "cmf": {
        "material": "ABS",
        "finish": "textured_light",
        "color": "Warm office grey, NCS S 2002-Y (light warm neutral)",
        "secondary_ops": [
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Preserve the single-plane front face with the display as the only interruption; no visible screw bosses, parting-line steps, or speaker grilles on the front.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Keep the top-edge intake as a single narrow slot array (max 6 mm wide) positioned within the 12\u00b0 top chamfer so it reads as a design line, not a vent.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Display window must remain at least 78 x 40 mm with emissive contrast suitable for reading from 1.5 m in office lighting; do not reduce window size or recess it more than 0.5 mm.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Moulded-in light texture (MT-11010 equivalent) on all cosmetic surfaces to hide fingerprints; no secondary paint or gloss on the main shell.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C recess on the back face centred at 50% width and 30% height, with a 0.8 mm lead-in chamfer and no visible connector surround on the front.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Maintain 4 mm nominal wall and a snap-fit front-to-back assembly with no metal inserts, keeping housing BOM at or below CNY 18/unit at 10,000 units/year.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The chamfered-slab silhouette gives the friendliest read of the allowed forms without added tooling complexity: a single 12\u00b0 top chamfer replaces a full radius blend and doubles as the intake plane, so the vent becomes an intentional line rather than a hole. The front face stays a clean monolith, which is what makes the display readable at a glance from a neighbouring desk; the 78 x 40 mm window at 42% height sits near the visual centre of the front face for natural eye-line when the unit is on a desk. USB-C on the back keeps the front uninterrupted and is the least-touched face in office handling, preserving the fingerprint-free appearance longer. ABS with a light moulded texture (MT-11010) hits the fingerprint-hiding must-have at the lowest cost of the three allowed materials, and a single pad-print operation adds the minimal branding required without breaking the CNY 18 ceiling. Mass stays well under 180 g because the slab uses a consistent 4 mm wall and snap-fit closures rather than screws and inserts."
    },
