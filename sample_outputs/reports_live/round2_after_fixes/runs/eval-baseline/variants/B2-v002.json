    "concept": {
      "variant_id": "B2-v002",
      "brief_id": "B2",
      "direction": "soft_pebble",
      "name": "Pebble Grip Site Detector",
      "form_language": "Soft pebble-form handheld detector: a continuous, organically-curved rounded slab with no sharp edges or exposed corners, achieved through generous radii in plan and section. The perimeter is a co-moulded TPE bumper band that wraps all four sides and absorbs drop energy while giving glove-friendly grip. A single recessed front face carries a sunken, gasket-sealed display window in the upper zone; a large open intake grille protected by an ePTFE membrane vent sits in the lower zone. A single top-edge USB-C port has a tethered rubber flap. Chunky moulded ribs on the rear provide finger registration; a moulded lanyard loop at one end. The whole object reads as one smooth, high-visibility pebble that survives being thrown into a site bag.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 123.0,
        "width": 74.0,
        "height": 29.0
      },
      "corner_radius_mm": 14.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 30.0
      },
      "display_window_mm": {
        "width": 46.0,
        "height": 26.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 74.0
      },
      "usb": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "PC-ABS",
        "finish": "textured_light",
        "color": "High-visibility safety orange (RAL 2004), UV-stabilised, with charcoal-grey TPE bumper band",
        "secondary_ops": [
          "soft_touch",
          "pad_print"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Co-moulded TPE bumper band must wrap the entire perimeter with a minimum 2.5 mm radial thickness at the four impact zones, providing both 1.5 m drop energy absorption and glove-friendly grip; it is a structural, not decorative, feature.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "The pebble silhouette and 14 mm corner radius are the drop-survival enabler and must not be sharpened or flattened to gain internal volume; any volume changes must come from wall thickness or internal ribbing.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Front-face intake must remain a single large-aperture grille at >=15% open area, covered internally by an ePTFE membrane vent plus gasket to reconcile IP65 with airflow; do not substitute a sealed or louvred-only intake.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Safety-orange UV-stabilised PC-ABS body with textured_light moulded-in texture: the mould texture must be deep enough to remain grippy with gloves yet not trap site dust; no smooth-gloss body surfaces anywhere.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "USB-C charging port on the top edge with a tethered rubber flap, and a moulded lanyard loop at the opposite end, both operable with work gloves and without removing the device from its holster.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Sealing strategy is a two-part shell with a single perimeter foam gasket and a membrane vent, keeping part count and BOM at or under CNY 18; do not add overmoulded gaskets or multi-shot seals beyond the TPE band.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The soft_pebble direction is chosen because a continuous curved form is the cheapest way to survive a 1.5 m drop: there are no stress-concentrating corners, and the energy can be managed by a perimeter TPE band rather than by a thick, heavy shell. Keeping the body at 29 mm thickness and 123 x 74 mm plan keeps the moulded mass comfortably under 180 g while leaving room for the ~92 g of internals, the ePTFE vent and the gasket. PC-ABS is specified over straight ABS because it buys impact strength at low cost, and textured_light is specified over textured_heavy so that site dust and mud do not pack into the grain. Safety orange (RAL 2004) with UV stabiliser satisfies both the high-visibility and UV-resistance must-haves at negligible cost. The front face is deliberately kept simple: display high, intake low, so the intake grille can be as large as possible while still draining and shielding the membrane vent. The top-edge USB flap keeps the sealing plane away from the main gasket and is easy to operate with gloves. Cost is protected by a two-part shell, one gasket, one vent and a single TPE band, which keeps the design inside the CNY 18 BOM ceiling without needing the ultrasonic weld that would complicate rework and recycling. The design also stays within the contract's allowed materials, finishes and IP65/drop targets, and the rABS option remains open for a future sustainability revision without changing the tool."
    },
