    "concept": {
      "variant_id": "B4-v002",
      "brief_id": "B4",
      "direction": "monolith_slab",
      "name": "Monolith Slab",
      "form_language": "A single monolithic chamfered slab: one continuous rABS shell with a gentle 2.5 mm top chamfer running the full perimeter, giving an honest, warm, slightly brutalist object that reads as one solid piece of material rather than an assembly. The front face is a quiet matte field with a modest recessed display window; the top face carries an honest linear intake grille of moulded slots. No part lines are hidden; the single visible seam is a deliberate, tool-free pry channel along the bottom edge, celebrating repairability instead of disguising it. Speckle from the recycled ABS is left fully visible; no graphics, no coatings, no secondary colours.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 6.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 44.0
      },
      "display_window_mm": {
        "width": 52.0,
        "height": 22.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "Natural warm grey recycled ABS with visible darker speckles (no added colorant), approx. NCS S 4005-Y20R",
        "secondary_ops": []
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Every plastic part, including the housing, display bezel and internal brackets, is rABS; no other polymer family is permitted anywhere in the housing assembly.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "No paint, soft-touch, pad-print, laser-etch, IML or TPE overmold on any exterior or interior surface; the speckled, lightly textured rABS tool finish is the final aesthetic.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "The housing opens along a single bottom-edge pry channel with repeated-open cantilever snap-fits and no screws, adhesives or heat stakes; all internal modules lift out by hand for repair or recycling.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "The top-face intake is a moulded linear slot grille (no separate mesh or insert) whose ribs are structural and whose open area meets the sensor airflow requirement without adding a second material.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "The chamfered slab silhouette with 6 mm corner radii and a single continuous top chamfer defines the family look; the slab must not gain bolted-on bumpers, feet or decorative trims.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Housing wall thickness is held at 2.0 mm nominal with local 2.4 mm ribs so the shell stays within the 180 g mass budget while surviving the 1 m drop assumption.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "This variant answers the B4 brief by treating repairability and mono-materiality as the aesthetic itself. The chamfered slab is the lowest-cost, lowest-risk way to hit the 125 x 75 x 30 mm envelope and the CNY 18 BOM ceiling: a two-part rABS shell, one tool family, no inserts, no coatings and no secondary operations, so the sustainability score is maximised and the cost score is protected. The top-face intake keeps the front face honest and uninterrupted, while the single bottom pry channel resolves conflict C1 without screws, gaskets or extra parts; repeated-open snap-fits in rABS are validated by the 2.0 mm nominal wall and local ribbing. The 6 mm radii and continuous top chamfer give the warm, slightly brutalist character the style keywords ask for, and the natural speckled rABS is deliberately left as the only colour and texture. The result is an object that looks like what it is: one recycled material, built to be opened and recycled again."
    },
