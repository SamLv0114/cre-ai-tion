    "concept": {
      "variant_id": "B2-v001",
      "brief_id": "B2",
      "direction": "rugged_bumper",
      "name": "SiteGuard Bumper - High-Vis Rugged Detector",
      "form_language": "Chamfered-slab core body wrapped in a co-moulded TPE bumper ring that stands proud of every edge; four over-sized corner lugs read as impact absorbers; front face split into a recessed display well and a slotted intake grille with visible ePTFE membrane behind; all control affordances are 12 mm minimum, glove-scale ribs.",
      "silhouette": "bumpered",
      "envelope_mm": {
        "length": 125.0,
        "width": 75.0,
        "height": 30.0
      },
      "corner_radius_mm": 6.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 42.0,
        "height": 26.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 78.0
      },
      "usb": {
        "face": "right",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "PC-ABS",
        "finish": "textured_heavy",
        "color": "Safety orange body (RAL 2003-ish) with charcoal-grey TPE bumper, UV-stabilised masterbatch",
        "secondary_ops": [
          "tpe_overmold",
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "TPE bumper ring must stand 1.0-1.5 mm proud of the PC-ABS core on all edges and corners; the shell must never be the first contact in a 1.5 m drop onto concrete.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Front intake grille must retain >= 15% open area and be backed by an ePTFE membrane vent plus perimeter gasket so IP65 is met without blocking airflow.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Every user interface element (display bezel, intake slot pitch, USB flap) must be operable with 3 mm-thick work gloves: no feature smaller than 12 mm, no recess deeper than 4 mm.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Keep safety-orange body colour with UV-stabilised masterbatch and pad-printed/laser-etched high-contrast markings; do not downgrade to a low-visibility grey or pastel.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Part count and joining must stay within the CNY 18 BOM: two-shot or overmoulded bumper plus foam gasket, no secondary sealing screws beyond the USB flap.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "USB-C port on the right face must sit behind a tethered TPE flap with a >2 mm compression seal land to preserve IP65 after repeated openings.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "The bumpered silhouette directly serves the brief's protected-corner and drop-survival must-haves: a co-moulded TPE ring absorbs the 1.5 m concrete impact that a bare PC-ABS shell would not, while a textured_heavy finish on the core gives the grippy, glove-friendly surface without extra cost. Placing both the display and the intake on the front face keeps the user's view and the sampled air on the same side, simplifying sealing to one gasket plane and helping hold the BOM near the CNY 18 ceiling. The safety-orange body with charcoal bumper satisfies high-visibility and rugged styling cues and gives a clear colour break for the overmould tooling. USB is moved to the right face so the front stays a clean sealed face for the display and membrane vent, reducing the number of penetrations that must survive IP65 testing."
    },
