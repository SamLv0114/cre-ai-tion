    "concept": {
      "variant_id": "B2-v002",
      "brief_id": "B2",
      "direction": "soft_pebble",
      "name": "Pebble Grip Field Detector",
      "form_language": "A soft-pebble monobloc slab: continuous convex curvature in plan and section, no flat side walls, so the hand wraps it naturally even gloved. A raised armour bead runs the full perimeter at mid-height to act as a sacrificial rub rail and corner protector; the four corners are the thickest, most rounded zones of the body. Front face is split into a recessed dark display window in the upper two-thirds and a recessed intake grille in the lower third, separated by a raised grip rib that doubles as a thumb rest. Two overmoulded TPE grip pads sit on the left and right flanks where fingers and thumb land, giving tactile orientation without a single sharp edge.",
      "silhouette": "pebble",
