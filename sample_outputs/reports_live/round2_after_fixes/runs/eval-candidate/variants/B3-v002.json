    "concept": {
      "variant_id": "B3-v002",
      "brief_id": "B3",
      "direction": "monolith_slab",
      "name": "Monolith Slab Air Quality Detector",
      "form_language": "A single chamfered slab with a continuous 3 mm chamfer wrapping all four front corners and the top arris, giving the object the calm, furniture-like presence of a stone plinth. The front face is a blank matte field interrupted only by a horizontal smoked display window and a recessed intake grille at the top edge; the chamfer acts as a light-shadow line that reads as a soft reveal rather than a hard edge. No visible screws, no parting-line step, and no logo on the front; the USB-C port is hidden on the bottom face, so the object looks like a solid volume from sofa height.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 120.0,
        "width": 68.0,
        "height": 24.0
      },
      "corner_radius_mm": 3.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 54.0
      },
      "display_window_mm": {
        "width": 52.0,
        "height": 22.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 82.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm mineral grey (NCS S 2005-Y20R equivalent)",
        "secondary_ops": [
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Preserve the 3 mm full-perimeter chamfer as the only edge treatment; do not add a radius, a bead, or a parting-line step to the front face.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Keep the display window centred horizontally at 54% height on the front face, with a 52 x 22 mm aperture and a smoked, flush PMMA window; it must remain legible from 2.5-3 m.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "Hide all fasteners: no visible screws on any exterior face; use internal snap fits and a concealed bottom port cover, with the USB-C opening concealed on the bottom face.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Do not gloss the front face; keep the textured_light matte finish (SPI B-2 equivalent) and the warm mineral grey colour so the object reads as furniture, not consumer electronics.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Use rABS with a minimum 30% post-consumer content for the main housing and keep the total housing BOM at or below CNY 18/unit at 10,000 units/year.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Maintain the 120 x 68 x 24 mm envelope and keep the mass under 180 g with the 92 g internals; do not thicken walls beyond 2.0 mm nominal.",
          "category": "cost",
          "must_preserve": true
        }
      ],
      "rationale": "The monolith_slab direction is expressed as a chamfered slab with a 120 x 68 x 24 mm envelope, which stays inside the 125 x 75 x 30 mm contract and keeps the mass budget comfortable at an estimated 150 g. The 3 mm chamfer is chosen instead of a large radius because it is more tool-friendly for a thin-walled box, hides the parting line at the front arris, and gives the calm, stone-like silhouette the brief asks for. The front face is deliberately reduced to two elements: a 52 x 22 mm smoked display window and a top-edge intake. The display is sized for 2.5-3 m sofa viewing with high-contrast UI, and its 54% height position keeps it visible when the unit sits on a low sideboard. The intake is a row of small slots on the top face at 82% depth, angled away from the viewer so dust and light do not collect on the front. The USB-C port is on the bottom face to preserve the clean front, accepting a small ergonomic trade-off that is acceptable for a fixed indoor appliance. CMF uses rABS with 30% PCR, textured_light mold finish, and a warm mineral grey; pad_print provides the small status icon and laser_etch provides the hidden serial and certification marks on the bottom. Secondary ops are limited to pad_print and laser_etch to stay within the CNY 18 BOM ceiling, since soft_touch paint would add cost and process variability. Hidden fasteners are achieved with internal snap fits and a bottom port cover, so no screws are visible. The result is a quiet, furniture-like slab that meets the brief's must-haves while staying DFM-safe for injection moulding."
    },
