    "concept": {
      "variant_id": "B4-v002",
      "brief_id": "B4",
      "direction": "monolith_slab",
      "name": "Monolith Slab \u2014 Mono-Material rABS Air Detector",
      "form_language": "A single honest slab: one continuous chamfered-rectangle prism with a 3 mm top chamfer running the full perimeter, split by one horizontal parting line at 62% of the height so the whole upper half lifts off as one lid. No fasteners, no inserts, no coatings \u2014 the material is the finish. The front face is a calm, near-symmetric composition: a slightly recessed smoked viewing window for the display, a fine linear intake grille across the top face, and a single flush USB-C cut-out on the right side of the front face. Speckle from the recycled ABS regrind reads as intentional texture, like terrazzo, not as a defect.",
      "silhouette": "chamfered_slab",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 28.0
      },
      "corner_radius_mm": 4.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 58.0
      },
      "display_window_mm": {
        "width": 48.0,
        "height": 18.0
      },
      "intake": {
        "face": "top",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "usb": {
        "face": "front",
        "x_pct": 78.0,
        "y_pct": 22.0
      },
      "cmf": {
        "material": "rABS",
        "finish": "textured_light",
        "color": "warm natural rABS grey-beige (undyed regrind, visible dark speckles; Pantone warm grey 4C equivalent), no colorant added",
        "secondary_ops": [
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "Every plastic part \u2014 top lid, bottom housing, display bezel, and internal clip features \u2014 is rABS from the same regrind batch; no other polymer, no metal inserts, no paint or coating anywhere in the housing.",
          "category": "sustainability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "The housing opens screw-free via six moulded cantilever snap hooks on the long sides plus two pry slots at the rear corners; each hook survives 50 open/close cycles without whitening, and the parting line sits at 62% of the height so the whole lid lifts off as one piece.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "The rABS regrind speckle is a visible, undyed feature \u2014 texture_light mould finish (VDI 27) at 0.8\u20131.2 mm depth and no colorant, so colour variation between batches is expected and accepted.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Wall thickness is a uniform 2.0 mm (+/- 0.15) across both shells with 1.5 mm minimum at the chamfer and 1.0 mm nominal at snap-hook roots; no ribs thicker than 1.6 mm, to keep cycle time and shot weight inside the CNY 18 BOM ceiling.",
          "category": "cost",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "The 3 mm perimeter top chamfer is the single form gesture \u2014 it must not become a soft compound radius, and the display window must stay recessed 0.8 mm below the front plane so the bezel needs no separate cosmetic part.",
          "category": "form",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "The top-face intake grille is a row of 9 parallel slots, each 1.2 x 28 mm with 1.6 mm webs, moulded straight-pull in the tool; it must not be replaced by a mesh insert or a separate grille part.",
          "category": "durability",
          "must_preserve": true
        }
      ],
      "rationale": "This variant adapts the tooling-approved reference slab but trades its 8 mm soft radius for a 4 mm radius plus a 3 mm full-perimeter top chamfer, which reads as a machined monolith rather than a soft consumer blob \u2014 appropriate for the 'honest, warm' keywords while staying inside the same simple straight-pull tool. The 122 x 72 x 28 mm envelope leaves 3 mm of length and 2 mm of height against the contract ceiling for snap-hook draught and lid clearance. At 2.0 mm nominal wall the two shells consume roughly 78 g of rABS, keeping total product mass near 172 g against the 180 g limit and the shot weight inside the CNY 18 BOM ceiling. The top-face intake is the only face that stays clear of the desk and of the user's hand, so it protects the sensor path without needing a separate grille part or an IP seal; the front USB-C sits high-right so a cable does not cross the display window. No paint, no TPE overmold, no IML \u2014 the material itself, with its visible regrind speckle, is the CMF story, and laser-etched marks on the front face replace any printed label so the whole housing can go back into the regrind stream as one mono-material part. C1 (screw-free vs durability) is addressed by cantilever hooks with generous 1.0 mm roots and a 62% parting line that puts the pry slot away from the drop-critical corners; C2 (rABS cost) is addressed by the 2.0 mm uniform wall and the absence of any secondary cosmetic part."
    },
