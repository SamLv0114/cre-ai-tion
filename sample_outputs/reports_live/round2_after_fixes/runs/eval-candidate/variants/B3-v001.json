    "concept": {
      "variant_id": "B3-v001",
      "brief_id": "B3",
      "direction": "soft_pebble",
      "name": "Pebble Sofa Reader",
      "form_language": "A calm pebble-derived solid: the plan outline is a continuous tangent arc with no flat side walls, the front face swells gently forward (2 mm crown) while the back stays almost flat to sit close to a wall, and the elevation tapers from a 29 mm belly to 24 mm at the top and bottom edges. The display is set into a shallow elliptical recess with a 0.6 mm shadow gap instead of a bezel, so the screen reads as a window cut into stone. The intake is a soft arc of slots that follows the front crown, and the USB recess is hidden under the bottom curve so no port breaks the front view. No visible fasteners: the two housing halves meet on a fine 0.15 mm shadow line that runs around the side wall, and all screws sit in blind bosses reached through the USB recess.",
      "silhouette": "pebble",
      "envelope_mm": {
        "length": 118.0,
        "width": 68.0,
        "height": 29.0
      },
      "corner_radius_mm": 13.5,
      "display": {
