    "concept": {
      "variant_id": "B2-v001",
      "brief_id": "B2",
      "direction": "rugged_bumper",
      "name": "Hi-Vis Site Sentinel",
      "form_language": "Chunky handheld slab with a full-perimeter TPE bumper frame that projects 2.5 mm proud of the PC-ABS body on all six faces; deep-treaded bumper ribs wrap the left/right grip zones and the four corners are swollen into impact-absorbing lobes. The front face is a shallow inset field carrying a recessed, gasket-sealed display window with a raised protective lip, and the lower front carries a moulded ePTFE membrane vent grille behind a coarse dust louvre. Controls are two oversized 14 mm rubber-capped buttons on the top face, angled toward the thumbs. Overall read: a tool, not a gadget.",
      "silhouette": "bumpered",
      "envelope_mm": {
        "length": 122.0,
        "width": 72.0,
        "height": 29.0
      },
      "corner_radius_mm": 10.0,
      "display": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 38.0
      },
      "display_window_mm": {
        "width": 42.0,
        "height": 22.0
      },
      "intake": {
        "face": "front",
        "x_pct": 50.0,
        "y_pct": 82.0
      },
      "usb": {
        "face": "bottom",
        "x_pct": 50.0,
        "y_pct": 50.0
      },
      "cmf": {
        "material": "PC-ABS",
        "finish": "textured_heavy",
        "color": "safety orange (RAL 2003) UV-stabilised body; charcoal grey (RAL 7021) TPE bumper frame",
        "secondary_ops": [
          "tpe_overmold",
          "pad_print",
          "laser_etch"
        ]
      },
      "intent_anchors": [
        {
          "anchor_id": "IA1",
          "statement": "The TPE bumper frame must remain a single continuous overmoulded loop that projects at least 2.0 mm beyond the PC-ABS body on every face and wraps the four corners as swollen lobes; this is the primary 1.5 m drop energy-absorbing feature and must not be reduced to a decorative trim strip.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA2",
          "statement": "Intake air must enter only through the front-face louvre into a sealed plenum, pass an ePTFE membrane, and exit to the sensor; the plenum and membrane seat must stay intact so the IP65 rating is not lost when the intake is opened for airflow.",
          "category": "durability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA3",
          "statement": "USB-C charge port lives on the bottom face under a captive rubber flap that is tethered to the bumper overmould and seals against a moulded lip; it must not be relocated to the front or side where a dropped unit would land on it.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA4",
          "statement": "Display window is recessed 1.5 mm behind a raised protective lip and sealed with a die-cut gasket; the window size of 42 x 22 mm must not shrink, as glove-friendly readability at arm's length was traded against bezel width.",
          "category": "usability",
          "must_preserve": true
        },
        {
          "anchor_id": "IA5",
          "statement": "Body colour must stay a UV-stabilised high-visibility safety orange per RAL 2003 with pad-printed/laser-etched labels rather than applied stickers, so the high-visibility requirement survives abrasion and sun exposure.",
          "category": "cmf",
          "must_preserve": true
        },
        {
          "anchor_id": "IA6",
          "statement": "Two top-face control buttons must each present at least a 14 mm diameter cap with 6 mm clearance between them and a tactile dome, meeting the glove-operation assumption from Q4; do not consolidate to a single multi-function button to save cost.",
          "category": "usability",
          "must_preserve": true
        }
      ],
      "rationale": "The bumpered direction is resolved as a PC-ABS core with a full-perimeter TPE overmould rather than separate corner bumpers, because a single continuous bumper loop is both cheaper to tool (one overmould station, no secondary assembly) and more effective at 1.5 m drop, spreading impact load around the enclosure instead of concentrating it at four discrete pads. PC-ABS is chosen over plain ABS for the body because the drop and UV requirements outweigh the ~CNY 1.2/unit material premium; the bumper itself is TPE at shore 65-75A, which is the cost-effective route to grip and impact without adding a separate part number. The front face is kept as the single functional face: display high and central for at-arm's-length reading, intake low and central so the vent louvre drains rather than traps water and so the operator's hand does not cover it when gripping the sides. USB is pushed to the bottom edge under a captive flap because a bottom-facing port is the least likely to be struck or submerged in a puddle when the unit is set down. The 2.5 mm bumper projection and 10 mm corner radius are set by the drop requirement, not by aesthetics; the 29 mm height and 122 x 72 mm footprint stay inside the 125 x 75 x 30 mm envelope with tooling margin, and the estimated housing mass of 78-84 g keeps total product mass near 176 g, under the 180 g cap. Cost is held by avoiding a separate display bezel part (window is gasket-sealed directly to a moulded lip), by using pad print and laser etch instead of IML, and by accepting the ~CNY 2.7 ePTFE vent as the one deliberate cost add that protects both IP65 and sensor airflow. The C1 cost conflict is resolved in favour of durability as the brief instructs, with the bumper overmould absorbing the drop energy that would otherwise require thicker, heavier, more expensive walls."
    },
